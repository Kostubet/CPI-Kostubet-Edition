<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.LauncherGlass" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">?attr/isLightTheme</item>
        <item name="android:windowLightNavigationBar">?attr/isLightTheme</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">@color/cpi_ui_background</item>
        <item name="colorPrimary">@color/cpi_ui_accent</item>
        <item name="colorAccent">@color/cpi_ui_accent</item>
        <item name="android:colorBackground">@color/cpi_ui_background</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
